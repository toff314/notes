        G2[Stable Diffusion<br/>三模块架构 L24]
        G3[Visual ChatGPT<br/>Task Matrix L26]
    end

    subgraph 产品与工程
        H1[AIGC产品三原则<br/>L27]
        H2[稳定输出<br/>JSON模式+seed 加餐一]
    end

